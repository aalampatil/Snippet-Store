PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://ADMIN:ADMIN@localhost:5432/snippetstore
# Empty for Android/iOS only. For browser development: http://localhost:8081
CORS_ORIGIN=
PUBLIC_API_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
SESSION_DAYS=7
# Local development only. Production always requires verification and SMTP.
REQUIRE_EMAIL_VERIFICATION=false
# Uncomment these to test email flows locally. Use TLS port 587 or 465 in production.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=Snippet Store <noreply@example.com>
# SMTP_USER=
# SMTP_PASSWORD=
