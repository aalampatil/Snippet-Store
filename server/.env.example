PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://ADMIN:ADMIN@localhost:5435/snippetstore
# Empty for Android/iOS only. For browser development: http://localhost:8081
CORS_ORIGIN=
PUBLIC_API_URL=http://localhost:3000
TRUST_PROXY_HOPS=0
SESSION_DAYS=7
# Legacy password signup only. OTP sign-in always verifies mailbox ownership.
REQUIRE_EMAIL_VERIFICATION=false
# Mailtrap Email Sandbox for local email/OTP testing.
EMAIL_PROVIDER=smtp
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=replace-with-mailtrap-sandbox-username
SMTP_PASSWORD=replace-with-mailtrap-sandbox-password
SMTP_FROM=Snippet Store <noreply@example.com>
# Production: set EMAIL_PROVIDER=resend, RESEND_API_KEY, and EMAIL_FROM.
# EMAIL_FROM must use a sender approved in your Resend account.
# RESEND_API_KEY=replace-with-resend-api-key
# EMAIL_FROM=Snippet Store <noreply@your-domain.com>
